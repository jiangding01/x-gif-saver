{
  "name": "x-gif-saver",
  "description": "一键把 X（Twitter）上的 GIF 保存为真正的 .gif 文件",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "compile": "wxt prepare && tsc --noEmit",
    "test": "vitest run",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "check": "pnpm compile && pnpm lint && pnpm test",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "gifenc": "1.0.3",
    "mp4box": "2.5.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@wxt-dev/module-react": "1.2.2",
    "typescript": "5.9.3",
    "vitest": "5.1.0",
    "wxt": "0.21.5"
  }
}
